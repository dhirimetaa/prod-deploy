# Copy is created as deploy/deploy.env by `prod-deploy init` (gitignored).
#
# cPanel: SSH host is usually the server hostname, user is the cPanel username,
# and PROD_REMOTE_PATH is the app folder (often ~/public_html or a subfolder).
# Point the domain document root at PROD_REMOTE_PATH/public when the app has one.

PROD_SSH_HOST=example.com
PROD_SSH_USER=cpanel_user
PROD_SSH_PORT=22
PROD_REMOTE_PATH=/home/cpanel_user/public_html

# Auth: password OR private key (key is tried first when the file exists)
# PROD_SSH_PASSWORD=
# PROD_SSH_KEY=C:/Users/You/.ssh/id_rsa
